{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    // Digest pins for actions and config-migration PRs.
    "config:best-practices",
    ":semanticCommits",
    "schedule:monthly",
    // Minor and patch in one PR. Majors stay separate.
    "group:allNonMajor",
  ],
  // The npm preset's 3-day wait would beat the 7-day minimumReleaseAge below.
  ignorePresets: ["security:minimumReleaseAgeNpm"],

  // A week gives a hijacked release time to be yanked. Security fixes skip the wait (Renovate's
  // default for vulnerabilityAlerts): a known vulnerability costs more than that small risk.
  minimumReleaseAge: "7 days",

  // A lock refresh has no release date, so minimumReleaseAge would hold it at
  // renovate/stability-days for good. pnpm's minimumReleaseAge keeps releases
  // younger than a week out of the refresh instead.
  lockFileMaintenance: { minimumReleaseAge: null },

  // Renovate merges itself once every check on the branch passes, not through
  // GitHub's auto-merge. A merge by the Renovate app is a push to main like any
  // other, so it deploys.
  platformAutomerge: false,

  packageRules: [
    // Renovate has no release date for a pin (renovatebot/renovate#40288), so minimumReleaseAge
    // would hold pin PRs at renovate/stability-days for good. A pin keeps the version the lock
    // already has, so it adds no new release to wait on. The ignored preset makes the same
    // exception.
    {
      matchUpdateTypes: ["pin"],
      minimumReleaseAge: null,
    },
    // Majors stay manual.
    {
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: true,
    },
    // A bump needs `uv run scripts/subset-fonts.py`; the open PR is the reminder.
    {
      matchPackageNames: ["@fontsource-variable/*"],
      automerge: false,
    },
    // `astro check` needs TypeScript's programmatic API, which 7.0 lacks.
    // Drop once 7.1 restores it: https://github.com/withastro/roadmap/discussions/1321
    {
      matchPackageNames: ["typescript"],
      allowedVersions: "!/^7\\.0\\./",
    },
  ],
}
