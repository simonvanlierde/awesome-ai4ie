---
/**
 * A Hugging Face Space that loads only when the reader asks for it. An eager
 * iframe pulls megabytes of the Space's app into every page view. Without JS
 * the plain link remains.
 */
interface Props {
  /** Numbered figure label (e.g. "Fig. 2"), continuing from Fig. 1 on the home page. */
  figure: string;
  title: string;
  /** Short caption set under the plate; defaults to the title and host. */
  caption?: string;
  /** The Space page on huggingface.co. */
  href: string;
  /** The URL the iframe loads (the Space's *.hf.space app). */
  src: string;
}
const { figure, title, caption, href, src } = Astro.props;
---

<figure class="space-embed-figure not-content">
  <space-embed class="space-embed" data-src={src} data-title={`Demo: ${title}`}>
    <div class="space-embed-bar">
      <span class="space-embed-title">{title}</span>
      <a class="space-embed-link" href={href}>Open {title} on Hugging Face</a>
    </div>
    <div role="status" class="space-embed-status"></div>
    <button type="button" class="space-embed-load" aria-label={`Load demo for ${title}`} hidden>
      Load demo
    </button>
  </space-embed>
  <figcaption class="space-embed-caption">
    <b>{figure}</b> {caption ?? `${title}, hosted on Hugging Face Spaces.`}
  </figcaption>
</figure>

<script>
  class SpaceEmbed extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector("button");
      const status = this.querySelector('[role="status"]');
      if (!button || !status) return;
      button.hidden = false;
      button.addEventListener("click", () => {
        if (!navigator.onLine) {
          status.textContent = "You're offline. Reconnect and try again.";
          return;
        }
        status.textContent = "Loading demo from Hugging Face…";
        const timer = setTimeout(() => {
          status.textContent = "Still loading. You can also use the Hugging Face link above.";
        }, 10000);
        const iframe = document.createElement("iframe");
        // The load event can also fire for blocked frames. Keep the direct
        // link available and use this event only to stop the loading message.
        iframe.addEventListener("load", () => {
          clearTimeout(timer);
          status.textContent = "";
        }, { once: true });
        iframe.src = this.dataset.src ?? "";
        iframe.title = this.dataset.title ?? "";
        iframe.referrerPolicy = "no-referrer";
        // A Space is third-party code: let it run, but not navigate this page.
        iframe.sandbox.add("allow-scripts", "allow-same-origin", "allow-forms", "allow-popups", "allow-downloads");
        button.replaceWith(iframe);
        iframe.focus();
      });
    }
  }
  customElements.define("space-embed", SpaceEmbed);
</script>
