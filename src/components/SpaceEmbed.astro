---
/**
 * A Hugging Face Space that loads only when the reader asks for it. An eager
 * iframe pulls megabytes of the Space's app into every page view. Without JS
 * the plain link remains.
 */
interface Props {
  title: string;
  description: string;
  /** The Space page on huggingface.co. */
  href: string;
  /** The URL the iframe loads (the Space's *.hf.space app). */
  src: string;
}
const { title, description, href, src } = Astro.props;
---

<space-embed class="space-embed not-content" data-src={src} data-title={`Demo: ${title}`}>
  <p class="space-embed-title">{title}</p>
  <p>{description}</p>
  <p><a href={href}>Open the Space on huggingface.co</a></p>
  <button type="button" class="space-embed-load" hidden>Load {title} (runs on huggingface.co, which loads further scripts)</button>
</space-embed>

<script>
  class SpaceEmbed extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector("button");
      if (!button) return;
      button.hidden = false;
      button.addEventListener("click", () => {
        const iframe = document.createElement("iframe");
        iframe.src = this.dataset.src ?? "";
        iframe.title = this.dataset.title ?? "";
        iframe.referrerPolicy = "no-referrer";
        // A Space is third-party code: let it run, but not navigate this page.
        iframe.sandbox.add("allow-scripts", "allow-same-origin", "allow-forms", "allow-popups", "allow-downloads");
        button.replaceWith(iframe);
        iframe.focus();
      });
    }
  }
  customElements.define("space-embed", SpaceEmbed);
</script>
