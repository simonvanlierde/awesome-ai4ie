---
// The link at the end of each gap under "Not mapped yet": opens the contribution
// form with the gap's name in its details.
import { contributeUrl } from "../lib/urls";

interface Props {
  gap: string;
}
const { gap } = Astro.props;
---

<a href={contributeUrl("resource", { details: `Gap: ${gap}\n\n` })}>
  Suggest a paper<span class="sr-only"> on {gap}</span><span aria-hidden="true">&nbsp;→</span>
</a>
