---
// Inline citation for a literature.yaml id, linked to the reading list filtered
// to that paper (?papers=<id>, the link the applications map also uses). An
// unknown id fails the build, and author and year come from the entry, so a
// citation in the prose cannot drift from the data.
import { getCollection } from "astro:content";
import { citeAuthors, formatAuthors, paperLink } from "../lib/literature";
import { litUrl } from "../lib/urls";

interface Props {
  id: string;
}

const { id } = Astro.props;

const entry = (await getCollection("literature")).find((e) => e.id === id);
if (!entry) {
  throw new Error(`<Cite id="${id}"/>: no literature.yaml entry with that id`);
}

const { year } = entry.data;
const title = `${formatAuthors(entry.data)} (${year}). ${paperLink(entry.data).label}`;

// With children, the citation wears the caller's words (a model name, say)
// instead of "(Author, Year)", so prose can name the thing and still link it.
const labelled = Astro.slots.has("default");

const href = litUrl({ papers: [id] });
---

<a class:list={["cite", { "cite-ref": !labelled }]} href={href} title={title}>{labelled ? <slot /> : `(${citeAuthors(entry.data)}, ${year})`}</a>
