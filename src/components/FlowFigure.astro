---
// Fig. 1 on the home page: the literature as a flow from IE field to AI
// technique. Built from literature.yaml at build time; see sankeyLayout for
// what the heights and numbers count.
import { getCollection } from "astro:content";
import { SHORT_LABELS, tagLabel } from "../data/tags";
import { sankeyLayout } from "../lib/sankey";
import { litUrl } from "../lib/urls";

// viewBox geometry, in user units: label column, flow, label column.
const H = 420;
const GAP = 18;
const X0 = 200;
const X1 = 480;
const NODE = 8;
const W = X1 + NODE + 290;
// Node links get at least this tall a hit area: 24px even at a 320px-wide
// screen, where the plate shrinks to about 0.37 (WCAG 2.5.8).
const HIT = 66;

const entries = (await getCollection("literature")).map((e) => e.data);
const { ieNodes, mlNodes, bands, total, papers } = sankeyLayout(entries, H, GAP);
const short = (tag: string) => SHORT_LABELS[tag as keyof typeof SHORT_LABELS] ?? tag;
// A node opens the list scoped to the flow (the other column's tags ORed), so
// the list shows exactly the papers the node's number counts.
const ieInFlow = ieNodes.map((n) => n.tag);
const mlInFlow = mlNodes.map((n) => n.tag);
const mid = (X0 + NODE + X1) / 2;
const band = (b: (typeof bands)[number]) =>
  `M${X0 + NODE} ${b.y0}C${mid} ${b.y0} ${mid} ${b.y1} ${X1} ${b.y1}` +
  `V${b.y1 + b.h}C${mid} ${b.y1 + b.h} ${mid} ${b.y0 + b.h} ${X0 + NODE} ${b.y0 + b.h}Z`;
const hitY = (n: { y: number; h: number }) => n.y + n.h / 2 - Math.max(n.h, HIT) / 2;
---

<figure class="flow not-content">
  <svg viewBox={`0 0 ${W} ${H}`}>
    <g class="flow-bands">
      {
        bands.map((b) => (
          // Out of the tab order: the 10 node links below reach the same lists
          // from the keyboard, and the literature filters reach every pair.
          <a
            href={litUrl({ ie: [b.ie], ml: [b.ml] })}
            tabindex="-1"
            aria-label={`${tagLabel("ie", b.ie)} with ${tagLabel("ml", b.ml)}: ${b.count} ${b.count === 1 ? "paper" : "papers"}`}
          >
            <path class={`band field-${b.ie}`} d={band(b)}>
              <title>{`${short(b.ie)} → ${short(b.ml)}: ${b.count}`}</title>
            </path>
          </a>
        ))
      }
    </g>
    {
      ieNodes.map((n) => (
        <a href={litUrl({ ie: [n.tag], ml: mlInFlow })} class="flow-node">
          <rect class="flow-hit" x="0" y={hitY(n)} width={X0 + NODE} height={Math.max(n.h, HIT)} />
          <rect class={`node field-${n.tag}`} x={X0} y={n.y} width={NODE} height={n.h} />
          <text x={X0 - 10} y={n.y + n.h / 2} text-anchor="end" dominant-baseline="middle">
            {`${short(n.tag)} `}
            <tspan class="flow-n">{n.papers}</tspan>
          </text>
        </a>
      ))
    }
    {
      mlNodes.map((n) => (
        <a href={litUrl({ ie: ieInFlow, ml: [n.tag] })} class="flow-node">
          <rect class="flow-hit" x={X1} y={hitY(n)} width={W - X1} height={Math.max(n.h, HIT)} />
          <rect class="node" x={X1} y={n.y} width={NODE} height={n.h} />
          <text x={X1 + NODE + 10} y={n.y + n.h / 2} dominant-baseline="middle">
            {`${short(n.tag)} `}
            <tspan class="flow-n">{n.papers}</tspan>
          </text>
        </a>
      ))
    }
  </svg>
  <figcaption>
    <span><b>Fig. 1</b> What the {papers} AI-in-IE papers apply, from IE field to AI technique.
      Numbers count papers; band width counts field-technique pairings ({total}), since one paper
      can sit in several bands. Follow a label or band to read the papers.</span>
    <span class="flow-src">Source: src/data/literature.yaml</span>
  </figcaption>
</figure>
