---
// A list of literature entries, newest first as given, each linked to its card on the
// reading list, then one link that opens them all there.
import type { LitEntry } from "../data/schemas";
import { citeAuthors } from "../lib/literature";
import { litUrl, paperUrl } from "../lib/urls";

interface Props {
  papers: LitEntry[];
}
const { papers } = Astro.props;
---

<ol class="lit-list not-content">
  {
    papers.map((p) => (
      <li class="lit-entry">
        <span class="lit-meta">
          {citeAuthors(p)}, {p.year}
        </span>
        <a href={paperUrl(p.id)} class="lit-title">
          {p.title}
        </a>
        <p class="lit-blurb">{p.blurb}</p>
      </li>
    ))
  }
</ol>
{
  papers.length > 1 && (
    <p>
      <a href={litUrl({ papers: papers.map((p) => p.id) })}>
        Open all {papers.length} papers in the literature list
      </a>
    </p>
  )
}
