---
import { getCollection } from "astro:content";
import ApplicationsExplorer from "./ApplicationsExplorer";

const entries = (await getCollection("applications"))
  .map((e) => ({ id: e.id, ...e.data }))
  .sort((a, b) => a.name.localeCompare(b.name, "en"));
---

{/* The grid is server-rendered; the view switch only needs to work once seen. */}
<ApplicationsExplorer client:visible entries={entries} />
