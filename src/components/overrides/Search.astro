---
// Starlight's search dialog (Pagefind, keyword matches across every page), plus a
// meaning search over the reading list: a reader who types a question gets the
// closest literature entries above the keyword results. The embedding model runs
// in the browser and loads only after the reader turns the search on.
import Default from "@astrojs/starlight/components/Search.astro";
---

<Default />

<semantic-search hidden>
  <p class="ss-hint">
    <span data-off>
      Tip: you can also ask in plain words, like “which papers sort waste with cameras?”
      <button type="button" class="ss-enable">Search the reading list by meaning</button>
      <span class="ss-note">Runs in your browser. The first time, it downloads code from cdn.jsdelivr.net and a 23 MB model from huggingface.co. Your query stays on your device.</span>
    </span>
    <span data-on hidden>Questions of three words or more also search the reading list by meaning.</span>
  </p>
  <p class="ss-status" role="status"></p>
  <ol class="ss-results" aria-label="Closest papers in the reading list"></ol>
</semantic-search>

<script>
  import { STALL_MS, TRANSFORMERS_URL } from "../../lib/transformers";
  import { type IndexEntry, isPhrase, rank } from "../../lib/semantic";
  import { StalledError, withStall } from "../../lib/stall";
  import { siteUrl } from "../../lib/urls";

  // Pinned to a commit of the Hugging Face repo, like the zero-shot demo's model.
  const MODEL = "Xenova/all-MiniLM-L6-v2";
  // biome-ignore lint/security/noSecrets: a public git commit id, not a secret
  const MODEL_REVISION = "751bff37182d3f1213fa05d7196b954e230abad9";
  const OPT_IN = "ai4ie-meaning-search";

  type Embed = (texts: string | string[]) => Promise<number[][]>;
  type Search = { entries: IndexEntry[]; vectors: number[][]; embed: Embed };

  let searchPromise: Promise<Search> | null = null;
  function getSearch(onProgress: (msg: string) => void): Promise<Search> {
    searchPromise ??= withStall(async (alive) => {
      const [{ pipeline }, entries] = await Promise.all([
        import(/* @vite-ignore */ TRANSFORMERS_URL),
        fetch(siteUrl("literature-index.json")).then((r) => r.json() as Promise<IndexEntry[]>),
      ]);
      alive();
      const pipe = await pipeline("feature-extraction", MODEL, {
        revision: MODEL_REVISION,
        dtype: "q8",
        progress_callback: (p: { status: string; file?: string; progress?: number }) => {
          if (!alive()) return;
          if (p.status === "progress" && p.file?.endsWith(".onnx"))
            onProgress(`Downloading the model… ${Math.round(p.progress ?? 0)}%`);
        },
      });
      const embed: Embed = async (texts) =>
        (await pipe(texts, { pooling: "mean", normalize: true })).tolist();
      onProgress("Reading the reading list…");
      // shortcut: embeds the 82 entries in the browser (about a second); precompute at build time if the list grows past a few hundred
      const vectors = await embed(entries.map((e) => e.text));
      return { entries, vectors, embed };
    }, STALL_MS).catch((err) => {
      searchPromise = null; // a failed load must not poison every retry
      throw err;
    });
    return searchPromise;
  }

  function remember(on: boolean) {
    try {
      if (on) localStorage.setItem(OPT_IN, "1");
      return localStorage.getItem(OPT_IN) === "1";
    } catch {
      return false;
    }
  }

  class SemanticSearch extends HTMLElement {
    #ready = false;

    connectedCallback() {
      // Moving into the Pagefind form below reconnects the element; set up once.
      if (this.#ready) return;
      this.#ready = true;
      const status = this.querySelector<HTMLElement>(".ss-status")!;
      const list = this.querySelector<HTMLOListElement>(".ss-results")!;
      let input: HTMLInputElement | null = null;
      let enabled = false;
      let timer: ReturnType<typeof setTimeout> | undefined;
      let seq = 0;

      const show = (hits: IndexEntry[]) => {
        list.replaceChildren(
          ...hits.map((e) => {
            const li = document.createElement("li");
            const a = document.createElement("a");
            a.href = e.href;
            a.textContent = `${e.title} (${e.year})`;
            const p = document.createElement("p");
            p.textContent = e.blurb;
            li.append(a, p);
            return li;
          }),
        );
      };

      const run = async () => {
        const q = input?.value.trim() ?? "";
        const mine = ++seq;
        if (!(enabled && isPhrase(q))) {
          show([]);
          if (enabled) status.textContent = "";
          return;
        }
        try {
          const s = await getSearch((m) => mine === seq && (status.textContent = m));
          const [qv] = await s.embed(q);
          if (mine !== seq) return; // a newer keystroke owns the results
          const hits = rank(qv, s.vectors).map((i) => s.entries[i]);
          show(hits);
          status.textContent = hits.length
            ? `${hits.length} close ${hits.length === 1 ? "paper" : "papers"} in the reading list:`
            : "No paper in the reading list is close to that question.";
        } catch (err) {
          // biome-ignore lint/suspicious/noConsole: the status line cannot show the cause; the console keeps it for debugging
          console.error(err);
          if (mine !== seq) return;
          status.textContent =
            err instanceof StalledError
              ? "The model download stopped making progress. Check your connection, then type again to retry."
              : "Could not load the meaning search. Check your connection, then type again to retry.";
        }
      };

      const enable = () => {
        enabled = true;
        this.querySelector<HTMLElement>("[data-off]")!.hidden = true;
        this.querySelector<HTMLElement>("[data-on]")!.hidden = false;
        void run();
      };

      this.querySelector(".ss-enable")!.addEventListener("click", (e) => {
        e.stopPropagation(); // Starlight closes the dialog on clicks it does not recognise
        remember(true);
        enable();
        input?.focus();
      });

      // Pagefind renders its input after the page is idle; move in below it once it exists.
      const container = document.querySelector("site-search .search-container");
      if (!container) return;
      const attach = () => {
        input = container.querySelector<HTMLInputElement>(".pagefind-ui__search-input");
        if (!input) return false;
        input.placeholder = "Search, or ask a question";
        input.form?.querySelector(".pagefind-ui__search-clear")?.after(this);
        input.addEventListener("input", () => {
          clearTimeout(timer);
          timer = setTimeout(run, 300);
        });
        this.hidden = false;
        if (remember(false)) enable();
        return true;
      };
      if (!attach()) {
        const mo = new MutationObserver(() => attach() && mo.disconnect());
        mo.observe(container, { childList: true, subtree: true });
      }
    }
  }
  customElements.define("semantic-search", SemanticSearch);
</script>

<style is:global>
  semantic-search {
    display: block;
    margin-block: 0.75rem;
    font-size: var(--sl-text-sm);
  }
  .ss-hint {
    color: var(--sl-color-gray-2);
  }
  .ss-enable {
    margin-inline-start: 0.25rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.25rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font: inherit;
    cursor: pointer;
  }
  .ss-enable:hover {
    border-color: var(--sl-color-accent);
  }
  .ss-note {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--sl-text-xs);
  }
  .ss-status:empty,
  .ss-results:empty {
    display: none;
  }
  .ss-status {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-2);
  }
  .ss-results {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .ss-results li {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
  }
  .ss-results li + li {
    margin-top: 0.5rem;
  }
  .ss-results a {
    color: var(--sl-color-white);
    font-weight: 600;
  }
  .ss-results p {
    margin: 0.25rem 0 0;
    color: var(--sl-color-gray-2);
  }
</style>
