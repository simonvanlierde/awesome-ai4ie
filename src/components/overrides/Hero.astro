---
// The splash template has no sidebar. Put the chapter links before the figure.
// Starlight renders the hero on every page with `hero` frontmatter: the home
// page and its built-in 404 page. The 404 keeps the chapter index and shows
// the mark as a plate where Fig. 1 would be.
// NOTE: unlike Starlight's own hero, this one ignores `hero.image`, the
// draft notice and inline icon HTML; no page uses them.
import { Icon } from "@astrojs/starlight/components";
import { CHAPTERS } from "../../lib/chapters";
import { issueUrl, siteUrl } from "../../lib/urls";
import BrandMark from "../BrandMark.astro";
import FlowFigure from "../FlowFigure.astro";

const { id, data } = Astro.locals.starlightRoute.entry;
const isHome = id === "" || id === "index";
const is404 = id === "404";
let { title = data.title, tagline } = data.hero ?? {};
if (is404) {
  title = "Page not found";
  tagline = `Search the site, choose a chapter, or <a href="${issueUrl("other")}">report a broken link</a>.`;
}
// The home title spells out AI4IE: "AI", "for" and the initials of "Industrial Ecology"
// are the keys the header wordmark's letters fly onto on load (script below), and the
// rest of each word fades in around them. Each word stays one nowrap box, because the
// keys are inline blocks, which a line may otherwise break beside. The split copy is
// hidden from assistive tech, which would read the inline blocks as separate words
// ("A I for I ndustrial"), and a visually hidden copy of the title names the heading.
const acronym = /^(.*) AI for Industrial Ecology$/.exec(title);
const key = (k: string, text: string) => `<span class="ac" data-ac="${k}">${text}</span>`;
const rest = (text: string) => `<span class="ac-rest">${text}</span>`;
const word = (html: string) => `<span class="ac-word">${html}</span>`;
const heading =
  isHome && acronym
    ? [
        rest(acronym[1]),
        word(key("a", "A") + key("i1", "I")),
        key("4", "for"),
        word(key("i2", "I") + rest("ndustrial")),
        word(key("e", "E") + rest("cology")),
      ].join(" ")
    : null;
---

<div class="cover">
  <div class="cover-grid">
    <div class="cover-copy">
      {
        heading ? (
          <h1 id="_top" data-page-title>
            <span class="sr-only">{title}</span>
            <span aria-hidden="true" set:html={heading} />
          </h1>
        ) : (
          <h1 id="_top" data-page-title set:html={title} />
        )
      }
      {
        isHome && acronym && (
          // Runs before the page paints: the title's parts stay hidden until the hand-off
          // script places them. Reduced motion, a seen session or blocked storage skips it.
          // If that script has not started within a second, the timeout shows the title,
          // and the session stays unseen, since the hand-off never played.
          <script is:inline>
            try {
              if (!matchMedia("(prefers-reduced-motion: reduce)").matches && !sessionStorage.getItem("ai4ie-handoff")) {
                document.documentElement.classList.add("ac-run");
                setTimeout(() => document.documentElement.classList.remove("ac-run"), 1000);
              }
            } catch {}
          </script>
        )
      }
      {tagline && <p class="cover-tagline" set:html={tagline} />}
    </div>
    {
      is404 && (
        // The dashed frame is the site's mark for a gap: a missing page is one.
        <figure class="plate not-content">
          <a href={siteUrl("")} class="plate-frame plate-link" aria-label="AI4IE — return to the home page">
            <BrandMark mode="glyph" large />
          </a>
        </figure>
      )
    }
  </div>
  <nav class="chapter-index" aria-label="Chapters">
    <ol>
      {
        CHAPTERS.map((c, i) => (
          <li style={`--chapter-ink: var(--ink-${i + 1})`}>
            <a href={siteUrl(`${c.slug}/`)}>
              <span class="chapter-title">{c.title}</span>
              <Icon name="right-arrow" class="chapter-arrow" />
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  {isHome && <FlowFigure />}
</div>

<script>
  // The hand-off: the header wordmark's letters fly to their keys in the title, measured
  // live from both, then the header mark fades back. Once per tab session; the inline
  // script after the title decides, so the title never flashes in its final place.
  const root = document.documentElement;
  const mark = document.querySelector<SVGSVGElement>(".site-title .brand-mark");
  const h1 = document.querySelector<HTMLElement>(".cover h1");
  if (root.classList.contains("ac-run") && mark && h1) {
    try {
      sessionStorage.setItem("ai4ie-handoff", "1");
    } catch {}
    const ease = "cubic-bezier(0.22, 1, 0.36, 1)";
    const box = mark.getBoundingClientRect();
    // The strokes' cap runs from 4.9 to 27.1 of the mark's 32 units; Archivo's cap is 0.7em.
    const srcCap = (box.height * 22.2) / 32;
    const srcMid = box.top + (box.height * 16) / 32;
    const cap = Number.parseFloat(getComputedStyle(h1).fontSize) * 0.7;
    // All keys leave together on one curve, so they keep their order and never cross.
    for (const k of ["a", "i1", "4", "i2", "e"]) {
      const el = h1.querySelector<HTMLElement>(`[data-ac="${k}"]`);
      const from = mark.querySelector(`.bm-${k}`)?.getBoundingClientRect();
      if (!el || !from) continue;
      const to = el.getBoundingClientRect();
      const dx = from.left - to.left;
      const dy = srcMid - (to.top + to.height / 2);
      el.animate(
        [
          { opacity: 0, transform: `translate(${dx}px, ${dy}px) scale(${srcCap / cap})` },
          { opacity: 1, offset: 0.15 },
          { opacity: 1, transform: "none" },
        ],
        { duration: 700, easing: ease, fill: "backwards" },
      );
    }
    h1.querySelectorAll(".ac-rest").forEach((el, i) =>
      el.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: 400,
        delay: 600 + i * 60,
        easing: "ease-out",
        fill: "backwards",
      }),
    );
    mark.animate([{ opacity: 0 }, { opacity: 0, offset: 0.75 }, { opacity: 1 }], {
      duration: 1200,
      easing: "ease-out",
    });
    root.classList.remove("ac-run");
  }
</script>
