---
// Home-page cover: the title beside Fig. 1, then the chapter index. The splash
// template has no sidebar, so the index is the way into the chapters.
// Starlight renders the hero on every page with `hero` frontmatter: the home
// page and its built-in 404 page. The 404 keeps the chapter index and shows
// the mark as a plate where Fig. 1 would be.
// NOTE: unlike Starlight's own hero, this one ignores `hero.image`, the
// draft notice and inline icon HTML; no page uses them. Action links resolve
// like Markdown links: `/path/` against the base, `repo:` to GitHub.
import { Icon, LinkButton } from "@astrojs/starlight/components";
import favicon from "../../../public/favicon.svg?raw";
import { CHAPTERS } from "../../lib/chapters";
import { contentUrl, issueUrl, siteUrl } from "../../lib/urls";
import BrandMark from "../BrandMark.astro";
import FlowFigure from "../FlowFigure.astro";

const { id, data } = Astro.locals.starlightRoute.entry;
const isHome = id === "" || id === "index";
const is404 = id === "404";
let { title = data.title, tagline, actions = [] } = data.hero ?? {};
if (is404) {
  // Starlight's 404 is titled "404" with a generic tagline; the plate's
  // caption already says 404, so the title says what happened instead.
  title = "Page not found";
  tagline = `Search at the top of the page, start from a chapter below, or <a href="${issueUrl("other")}">report a broken link</a>.`;
}
// The home title ends on the favicon tile as its end mark. The no-break space keeps the
// tile on the last word's line; the tile is hidden from readers, as the title names it.
// pathLength="1" lets custom.css ink each stroke in with a unit dash; the strokes are
// drawn twice, as a ghost the hover replay redraws over and as the ink itself.
const endMark = favicon
  .replace(/<!--[\s\S]*?-->/g, "")
  .replaceAll("<path ", '<path pathLength="1" ')
  .replace(
    /<g [\s\S]*<\/g>/,
    (g) =>
      g.replace("<g ", '<g class="endmark-ghost" ') + g.replace("<g ", '<g class="endmark-ink" '),
  )
  .replace(
    'role="img" aria-label="AI4IE"',
    'class="cover-endmark" aria-hidden="true" focusable="false"',
  );
const heading = isHome ? `${title}&nbsp;${endMark}` : title;
---

<div class="cover">
  <div class="cover-grid">
    <div class="cover-copy">
      <h1 id="_top" data-page-title set:html={heading} />
      {tagline && <p class="cover-tagline" set:html={tagline} />}
      <div class="cover-actions">
        {
          actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link, text, variant }) => (
            <LinkButton href={contentUrl(link)} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
            </LinkButton>
          ))
        }
      </div>
    </div>
    {isHome && <FlowFigure />}
    {
      is404 && (
        // The dashed frame is the site's mark for a gap: a missing page is one.
        <figure class="plate not-content">
          <a href={siteUrl("")} class="plate-frame plate-link" aria-label="AI4IE — return to the home page">
            <BrandMark mode="glyph" large />
          </a>
          <figcaption>
            <span>
              <b>Fig. 404</b> Nothing at this address. It may be mistyped, or the page has moved.
            </span>
          </figcaption>
        </figure>
      )
    }
  </div>
  <nav class="chapter-index" aria-label="Chapters">
    <ol>
      {
        CHAPTERS.map((c, i) => (
          <li style={`--chapter-ink: var(--ink-${i + 1})`}>
            <a href={siteUrl(`${c.slug}/`)}>
              <b class="running-no">{i + 1}</b>
              <span class="chapter-title">{c.title}</span>
              <Icon name="right-arrow" class="chapter-arrow" />
              <span class="chapter-gist">{c.gist}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</div>

<script>
  // Pointing at or tapping the end mark inks its strokes in again over a faint ghost.
  // Each replay swaps between two same-shaped keyframe sets, which restarts the CSS
  // animations; a hover during a run is ignored, so the strokes never jump mid-draw.
  const tile = document.querySelector(".cover-endmark");
  let started = 0;
  let round = false;
  tile?.addEventListener("pointerenter", () => {
    if (performance.now() - started < 500) return;
    started = performance.now();
    round = !round;
    tile.classList.remove("reink-a", "reink-b");
    tile.classList.add(round ? "reink-a" : "reink-b");
  });
</script>
