---
// Starlight's footer (edit link, last updated, previous and next page) with a colophon
// below it: the favicon tile as the page's end mark,
// then the licences. The 404 page keeps the licences but drops the mark, since
// its plate already shows it.
import Default from "@astrojs/starlight/components/Footer.astro";
import { basePath, repoUrl } from "../../site";
import Glyph from "../Glyph.astro";

const is404 = Astro.locals.starlightRoute.entry.id === "404";
---

<Default />
<p class="colophon">
  {!is404 && <Glyph tile />}
  <span>
    Content <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>{" · Code "}<a
      href={`${repoUrl}/blob/main/LICENSE`}>MIT</a
    >{" · "}<a href={`${basePath}/accessibility/`}>Accessibility</a>{" · "}<a
      href={`${basePath}/privacy/`}>Privacy</a
    >{" · "}<a href={`${basePath}/footprint/`}>Footprint</a>
  </span>
</p>
