---
// Fig. 2.1 on /literature-map/: the literature map as a static figure (no script), with its
// clusters as a table. /literature/ draws the same layout over the list, driven by its filters.
// See src/lib/litmap.ts for the layout.
import { getCollection } from "astro:content";
import { IE_TAGS, type IeTag, shortLabel, tagLabel } from "../data/tags";
import { litMap, THIN_CLUSTER } from "../lib/litmap";
import { litUrl, paperUrl } from "../lib/urls";
import { MapKey, MapPlot } from "./LiteratureMapPlot";

const FIELDS = Object.keys(IE_TAGS) as IeTag[];
const all = (await getCollection("literature")).map(({ id, data }) => ({ id, ...data }));
const byId = new Map(all.map((e) => [e.id, e]));
const map = litMap(all);
const points = map.points.map(([id, x, y, c]) => ({ id, x, y, c }));
const fieldOf = (id: string) => byId.get(id)?.ie[0] as IeTag | undefined;
const clusters = map.clusters.map((k, c) => {
  const m = points.filter((p) => p.c === c).map((p) => fieldOf(p.id));
  return {
    ...k,
    byField: Object.fromEntries(FIELDS.map((f) => [f, m.filter((x) => x === f).length])) as Record<
      IeTag,
      number
    >,
    none: m.filter((x) => !x).length,
  };
});
const unplaced = all.length - points.length;
const thin = clusters.filter((c) => c.thin);
const fieldTotals = FIELDS.map((f) => points.filter((p) => fieldOf(p.id) === f).length);
const none = points.filter((p) => !fieldOf(p.id)).length;
const title = (id: string) => {
  const e = byId.get(id);
  const f = fieldOf(id);
  return e ? `${e.title} (${e.year}), ${f ? tagLabel("ie", f) : "no IE field"}` : id;
};
---

{
  points.length === 0 ? (
    <p>
      The map needs the entry vectors, and this build has none (run <code>pnpm run embed</code>{" "}
      first).
    </p>
  ) : (
    <>
      <p class="litmap-skip">
        <a href="#litmap-table-section">Skip to the table</a>
      </p>
      <figure class="lm-figure litmap not-content">
        <p class="litmap-hint">Scroll sideways to see the whole map.</p>
        <div
          class="litmap-scroll"
          role="region"
          aria-label="Map of the literature, scrolls sideways on a narrow screen"
          tabindex="0"
        >
          <MapPlot
            w={map.w}
            h={map.h}
            clusters={map.clusters}
            points={points}
            fieldOf={fieldOf}
            href={paperUrl}
            title={title}
          />
        </div>
        <MapKey />
        <figcaption>
          <b>Fig. 2.1</b> {points.length} papers laid out by the meaning of their own title and
          abstract, so papers that read alike sit close together. Each shaded region is a cluster,
          named for the tag that sets it apart most from the whole list; the tags never shaped the
          layout, so a cluster and its name are a check, not an input. The axes have no unit,
          and a paper with several fields shows its first.
          {unplaced > 0 &&
            ` ${unplaced} ${unplaced === 1 ? "paper has" : "papers have"} no vector yet and ${unplaced === 1 ? "is" : "are"} not shown.`}
          {thin.length > 0 &&
            ` A dashed outline marks a cluster of fewer than ${THIN_CLUSTER} papers, where the list is thin: ${thin.map((k) => k.name).join(", ")}.`}
        </figcaption>
      </figure>

      <section class="apx-grid-wrap" id="litmap-table-section" aria-labelledby="litmap-table" tabindex="0">
        <p class="apx-grid-title" id="litmap-table">
          <b>Table 2.1</b> Papers by cluster and IE field
        </p>
        <table class="apx-grid">
          <thead>
            <tr>
              <th><span class="sr-only">Cluster</span></th>
              {FIELDS.map((f) => (
                <th scope="col" class={`field-${f}`}>
                  <a href={litUrl({ ie: [f] })}>{shortLabel(f)}</a>
                </th>
              ))}
              <th scope="col">None</th>
              <th scope="col">Papers</th>
            </tr>
          </thead>
          <tbody>
            {clusters.map((k) => (
              <tr>
                <th scope="row">
                  {k.name}
                  {k.thin && <> (thin)</>}
                </th>
                {FIELDS.map((f) => <td data-n={k.byField[f] ? Math.min(k.byField[f], 3) : undefined}>{k.byField[f]}</td>)}
                <td data-n={k.none ? Math.min(k.none, 3) : undefined}>{k.none}</td>
                <td><b>{k.n}</b></td>
              </tr>
            ))}
            <tr>
              <th scope="row">All papers</th>
              {fieldTotals.map((n) => <td><b>{n}</b></td>)}
              <td><b>{none}</b></td>
              <td><b>{points.length}</b></td>
            </tr>
          </tbody>
        </table>
      </section>
    </>
  )
}
