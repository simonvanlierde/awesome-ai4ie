---
import { getCollection } from "astro:content";
import LiteratureBrowser from "./LiteratureBrowser";
import { sortEntries } from "./litFilter";

const entries = sortEntries(
  (await getCollection("literature")).map((e) => ({ id: e.id, ...e.data })),
  "year",
);
---

<LiteratureBrowser client:load entries={entries} />
