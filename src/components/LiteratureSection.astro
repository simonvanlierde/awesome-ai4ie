---
import { getCollection } from "astro:content";
import LiteratureBrowser from "./LiteratureBrowser";

// No sorting here: LiteratureBrowser sorts what it renders, on the server too.
const entries = (await getCollection("literature")).map((e) => ({ id: e.id, ...e.data }));
---

<noscript>
  <p class="lit-noscript">Filtering and sorting need JavaScript. Every entry is listed below.</p>
</noscript>
<LiteratureBrowser client:load entries={entries} />
